{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "experiments/railway-android-software/Dockerfile"
  },
  "deploy": {
    "startCommand": "python3 -u /opt/zeus-trial.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "NEVER",
    "sleepApplication": true,
    "overlapSeconds": 0,
    "drainingSeconds": 0
  }
}
